# Copy this file to .env and replace placeholders with your own values.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/local_football_league
JWT_SECRET=replace-with-a-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SPECIAL_ID=replace-with-a-private-admin-id

# Brevo transactional email API over HTTPS (not SMTP).
# Register and verify this sender address in Brevo before sending.
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=replace-with-verified-sender@example.com
BREVO_SENDER_NAME=Local Football League

# Use your public HTTPS app URL in production.
APP_URL=https://big-boys-fc.vercel.app

# Comma-separated frontend origins in production (Vercel URL and custom domain).
FRONTEND_ORIGINS=https://big-boys-fc.vercel.app
