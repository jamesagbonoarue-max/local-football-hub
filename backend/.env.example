# Copy this file to .env and replace placeholders with your own values.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/local_football_league
JWT_SECRET=replace-with-a-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SPECIAL_ID=replace-with-a-private-admin-id

# Recommended transactional provider: Resend SMTP.
# Verify your sending domain and publish its SPF, DKIM and DMARC DNS records first.
# To use another SMTP provider, replace these values with its SMTP settings.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=replace-with-resend-api-key
SMTP_FROM="Local Football League <updates@your-verified-domain.example>"

# Use your public HTTPS app URL in production.
APP_URL=https://your-public-domain.example

# Comma-separated frontend origins in production (Vercel URL and custom domain).
FRONTEND_ORIGINS=https://your-frontend.vercel.app